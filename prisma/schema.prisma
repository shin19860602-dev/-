// データベーススキーマ
// 開発中は SQLite、本番はクラウド Postgres（Supabase想定）に切り替える。
// datasource の provider と url を変更するだけで移行できるように設計している。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 店舗（美容室2店舗＋まつ毛エクステ1店舗）
model Store {
  id        String   @id @default(cuid())
  slug      String   @unique // ログインURLに使う店舗識別子
  name      String
  kind      String // "SALON" | "LASH"
  colorKey  String // デザイン上の店舗カラー識別子: "a" | "b" | "c"
  createdAt DateTime @default(now())

  // 店舗共通のPINログイン試行のロック（誰のPINか分かる前の失敗回数はここで管理）
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  // 給料閲覧用パスワード（ハッシュ化）。スタッフが自店舗の給料を見る際、追加で入力する。
  payrollPassword       String?
  payrollFailedAttempts Int       @default(0)
  payrollLockedUntil    DateTime?

  // 雇用保険料率（労働者負担分、%）。毎年度改定されるためオーナーが更新する。
  insuranceRate Float @default(0)

  staff      Staff[]
  customers  Customer[]
  visits     Visit[]
  menuItems  MenuItem[]
}

// スタッフ（オーナー／マネージャー／スタッフ）
model Staff {
  id     String @id @default(cuid())
  storeId String? // オーナーは全店舗を見るため店舗に紐付かない（null可）
  store   Store?  @relation(fields: [storeId], references: [id])

  name      String
  role      String // "OWNER" | "MANAGER" | "STAFF"
  title     String? // 表示用の肩書き（店長・スタイリスト・アイリスト等）

  // スタッフ／マネージャーは4桁PINでログイン、オーナーはメール＋パスワード
  pinHash      String?
  email        String?  @unique
  passwordHash String?

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  hireDate  DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  // 歩合手当の計算に使う歩合率（%）。給料画面からオーナーが設定する。
  serviceCommissionRate Float @default(0) // 技術歩合率
  productCommissionRate Float @default(0) // 商品歩合率

  visits            Visit[]
  primaryCustomers  Customer[] @relation("PrimaryStaff")
  salaries          Salary[]
}

// お客様（カルテ台帳）
model Customer {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  name        String
  kana        String?
  gender      String? // "male" | "female" | "other"
  birthday    DateTime?
  phone       String?
  postalCode  String? // 郵便番号
  address     String? // 住所
  tier        String    @default("一般会員") // "一般会員" | "プレミアム会員"
  memberSince DateTime?
  allergyNote String? // アレルギー・注意事項

  primaryStaffId String?
  primaryStaff   Staff?  @relation("PrimaryStaff", fields: [primaryStaffId], references: [id])

  active    Boolean  @default(true) // 施術履歴が残っている場合、削除の代わりにここをfalseにする
  createdAt DateTime @default(now())
  visits    Visit[]
}

// 施術メニュー・店販商品の一覧（店舗ごと）
model MenuItem {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  type  String // "service"（施術メニュー） | "product"（店販商品）
  name  String
  price Int // 目安金額（円）。売上登録時に初期値として使う

  sortOrder Int      @default(0) // 表示順（店舗・種別ごとに小さい順）。設定画面の並び替えで変更する
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 給与データ（オーナーのみ登録・編集でき、スタッフは自店舗分のみ閲覧できる非公開情報）
model Salary {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  yearMonth String // "2026-09" 形式（対象月）

  // 支給
  baseSalary        Int @default(0) // 基本給
  serviceCommission Int @default(0) // 技術歩合手当
  productCommission Int @default(0) // 商品歩合手当
  specialAllowance  Int @default(0) // 特別手当

  // 控除（所得税・住民税は税額表や自治体からの通知額を参照する必要があり自動計算できないため手入力）
  employmentInsurance Int @default(0) // 雇用保険
  incomeTax           Int @default(0) // 所得税
  residentTax         Int @default(0) // 住民税

  memo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, yearMonth])
}

// 来店・施術記録（＝カルテ明細であり、同時に売上明細でもある）
model Visit {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  date       DateTime
  menuName   String // 施術メニュー（例: カット＋カラー）
  amount     Int // 施術の金額（円）
  pointAmount   Int? // ポイント売上（円）
  productName   String? // 店販した商品名（例: シャンプー）
  productAmount Int? // 店販の金額（円）
  paymentMethod String? // "cash"（現金） | "credit"（クレジット）
  memo       String? // 接客メモ
  chemicalDetail String? // 薬剤・技術詳細（カラー剤、ロッド、放置時間など）

  createdAt DateTime @default(now())
}
